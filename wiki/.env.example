# Copy to .env and edit. Never commit .env.
# Password for the 'kai' admin account (wiki editing + mod uploads).
# Required on first boot, otherwise the app starts with editing locked.
WIKI_ADMIN_PASSWORD=change-me

# Random string that signs login cookies. Any long random value; changing it
# logs everyone out.
WIKI_SECRET_KEY=

# Discord OAuth (optional). Both are required for the Discord button to appear.
# The secret is a credential - never commit it, and reset it in the Discord
# developer portal if it is ever pasted into a chat, issue or commit.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
