# Copy to .env and edit. Never commit .env.
# Password for the 'kai' admin account (wiki editing + mod uploads).
# Required on first boot, otherwise the app starts with editing locked.
WIKI_ADMIN_PASSWORD=change-me

# Random string that signs login cookies. Any long random value; changing it
# logs everyone out.
WIKI_SECRET_KEY=

# Hostnames Traefik routes to the wiki (8001) and mods (8004) sites.
WIKI_HOSTNAME=wiki.example.com
MODS_HOSTNAME=mods.example.com
