{
  "name": "breakmine-workspace",
  "private": true,
  "version": "1.0.0",
  "main": "src/js/net/minecraft/server/main.js",
  "workspaces": [
    "apps/website"
  ],
  "scripts": {
    "start": "electron .",
    "devs:https": "vite --host",
    "devs:http": "vite --host --config vite.http.config.js",
    "devs:all": "concurrently \"npm run devs:https\" \"npm run devs:http\"",
    "build:single": "node scripts/build-assets.js --include-music && vite build --config vite.singlehtml.config.js",
    "dist": "node appbuild.js --linux --win",
    "dist:linux": "node appbuild.js --linux",
    "dist:win": "node appbuild.js --win",
    "preview": "vite preview",
    "server": "node server.js",
    "worldgen:import": "node packages/vanilla-worldgen/scripts/import-jar.mjs",
    "worldgen:import-render": "node packages/vanilla-worldgen/scripts/import-render-assets.mjs",
    "worldgen:import-decoration-render": "node packages/vanilla-worldgen/scripts/import-render-assets.mjs --decoration",
    "worldgen:import-block-rules": "node packages/vanilla-worldgen/scripts/import-block-rules.mjs",
    "worldgen:build": "node packages/vanilla-worldgen/scripts/build.mjs",
    "worldgen:verify": "node packages/vanilla-worldgen/scripts/verify-jar.mjs",
    "worldgen:verify-features": "node packages/vanilla-worldgen/scripts/verify-features.mjs",
    "worldgen:test": "node --test packages/vanilla-worldgen/test/*.test.mjs",
    "gameplay:import": "node packages/vanilla-gameplay/scripts/import-gameplay.mjs",
    "gameplay:test": "node --test packages/vanilla-gameplay/test/*.test.mjs",
    "website:dev": "npm --prefix apps/website run dev",
    "website:build": "npm --prefix apps/website run build",
    "website:worker:check": "npm --prefix apps/website run worker:check",
    "build": "node scripts/build-assets.js && vite build",
    "dev": "npm run devs:http"
  },
  "dependencies": {
    "bad-words": "^4.1.5",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.6.0",
    "buffer": "^6.0.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "toml": "^5.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.5",
    "electron": "^43.2.0",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.1.0"
  }
}
