{
  "name": "breakmine",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Minecraft in javascript",
  "main": "src/js/net/minecraft/server/main.js",
  "scripts": {
    "start": "electron .",
    "start-dev": "concurrently \"vite --config vite.http.config.js\" \"wait-on http://localhost:8000 && electron .\"",
    "devs:https": "vite --host",
    "devs:http": "vite --host --config vite.http.config.js",
    "devs:all": "concurrently \"npm run devs:https\" \"npm run devs:http\"",
    "build": "node scripts/build-assets.js && vite build",
    "build:single": "node scripts/build-assets.js --include-music && vite build --config vite.singlehtml.config.js",
    "dist": "node appbuild.js --linux --win",
    "dist:linux": "node appbuild.js --linux",
    "dist:win": "node appbuild.js --win",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/BreakmineDevelopers/breakmine_revived.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://codeberg.org/BreakmineDevelopers/breakmine_revived/issues"
  },
  "homepage": "https://codeberg.org/BreakmineDevelopers/breakmine_revived#readme",
  "dependencies": {
    "bad-words": "^4.1.5",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.6.0",
    "buffer": "^6.0.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.3",
    "toml": "^5.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.21.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "better-sqlite3@11.10.0": true,
    "electron-winstaller@5.4.0": true,
    "github:devsnek/node-register-scheme#e7cc9a63a1f512565da44cb57316d9fb10750e17": true
  }
}
