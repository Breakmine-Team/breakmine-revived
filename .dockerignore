# Dependencies are reinstalled inside the image.
node_modules

# Version control and local noise.
.git
.gitignore
*.log
npm-debug.log*
.DS_Store
.vscode
.idea
.env

# Runtime state: auth.db (password hashes) and secrets.json (the JWT signing
# secret). These must never end up in a build layer -- Docker creates a volume
# over this path instead.
data

# Regenerated by `npm run build` (build-assets.js + vite build).
dist
dist-single

# Separate project with its own Dockerfile and compose file.
wiki
