# Game client, served as plain static files.
#
# index.html is already a native-ESM entry point (<script type="module"
# src="src/js/Start.js">) and the source tree has no bare npm imports, so no
# bundler is required. Skip the vite build entirely.

# ---- asset generation stage --------------------------------------------------
FROM node:24-slim AS assets

WORKDIR /app

# src/resources.js (7 MB) and src/js/assetManifest.js are generated from the
# source tree by scripts/build-assets.js and are gitignored, so a fresh checkout
# cannot serve the client without this step. The script uses only node builtins,
# so no npm install is needed here.
COPY scripts/ ./scripts/
COPY src/ ./src/
RUN node scripts/build-assets.js

# ---- serve stage -------------------------------------------------------------
FROM nginx:1.27-alpine

COPY --from=assets /app/src/ /usr/share/nginx/html/src/
COPY index.html style.css /usr/share/nginx/html/
COPY libraries/ /usr/share/nginx/html/libraries/

# Listen on 8000 in the image rather than rewriting the stock config at runtime,
# so the port cannot silently end up as 80. mime.types is required: without it
# the browser gets application/octet-stream for every .js and the game will not
# boot. No SPA fallback here -- the client requests real files, and a fallback
# would turn a missing .js into a confusing HTML response instead of a 404.
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 8000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        try_files $uri =404;
    }
}
EOF

EXPOSE 8000
